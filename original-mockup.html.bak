    <div class="rail-icon"><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg></div>
    <div class="rail-icon"><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"/></svg></div>
    <div class="rail-icon"><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><circle cx="12" cy="18" r="3"/><path d="M6 9v2a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3V9"/><path d="M12 14v1"/></svg></div>
    <div class="rail-icon"><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="20" x2="4" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="20" y1="20" x2="20" y2="14"/></svg></div>
    <div class="rail-icon"><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg></div>

    <div class="spacer"></div>

    <div class="rail-icon"><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg></div>
    <div class="rail-icon notif"><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg></div>
    <div class="rail-icon"><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 1 1 5.8 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
    <div class="rail-icon"><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div>
    <div class="user-avatar">D</div>
  </div>

  <!-- Canvas -->
  <div class="canvas">
    <div class="run-chip">
      <svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></svg>
      Run
    </div>

    <svg class="edge-svg">
      <path d="M 360 300 C 415 300, 415 340, 470 340" stroke="#c9ccd1" stroke-width="1.5" fill="none"/>
    </svg>

    <!-- Scheduled Execution -->
    <div class="node" id="node-schedule">
      <span class="port left"></span>
      <span class="port right"></span>
      <div class="header">
        <div class="ico">
          <svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><circle cx="17" cy="16" r="2"/></svg>
        </div>
        <div class="title">Scheduled Execution 2</div>
      </div>
      <div class="desc">Trigger a workflow execution at a specific time.</div>
      <div class="footer">
        <div class="left">
          <svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          View Results
        </div>
        <div class="right"><span>0.00 sec</span></div>
      </div>
    </div>

    <!-- Browser Navigation Replay -->
    <div class="node selected" id="node-replay">
      <span class="port left"></span>
      <span class="port right"></span>
      <div class="header">
        <div class="ico">
          <svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="14" rx="2"/><line x1="8" y1="22" x2="16" y2="22"/><line x1="12" y1="18" x2="12" y2="22"/></svg>
        </div>
        <div class="title">Browser Navigation Repla...</div>
      </div>
      <div class="desc">Replay a saved browser navigation recording from the shared browser...</div>
      <div class="footer">
        <div class="left">
          <svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          View Results
        </div>
        <div class="right"><span>0.00 sec</span><span>v1.0.0</span></div>
      </div>
    </div>

    <!-- Bottom toolbar -->
    <div class="bottom-toolbar">
      <div class="ask-ai">
        <svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 L14 9 L21 10 L15.5 14.5 L17 21 L12 17.5 L7 21 L8.5 14.5 L3 10 L10 9 Z"/></svg>
        Ask AI
      </div>
      <div class="add-btn">
        <svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add
      </div>
      <div class="divider"></div>
      <div class="tool-ico" title="Undo"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/></svg></div>
      <div class="tool-ico" title="Redo"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 7v6h-6"/><path d="M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3L21 13"/></svg></div>
      <div class="divider"></div>
      <div class="tool-ico" title="Zoom in"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg></div>
      <div class="tool-ico" title="Zoom out"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="8" y1="11" x2="14" y2="11"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg></div>
      <div class="tool-ico" title="Select"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4 3 L4 18 L8.5 14 L11 20 L13.5 19 L11 13 L17 13 Z"/></svg></div>
      <div class="tool-ico" title="Fit"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8V5a2 2 0 0 1 2-2h3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M21 16v3a2 2 0 0 1-2 2h-3"/></svg></div>
      <div class="tool-ico" title="Page"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div>
      <div class="tool-ico" title="Layout"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 L22 8 L12 14 L2 8 Z"/><path d="M2 16 L12 22 L22 16"/></svg></div>
      <div class="tool-ico" title="Screenshot"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg></div>
    </div>
  </div>

  <!-- Collapse tab -->
  <div class="side-tab">
    <svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
  </div>

  <!-- Inspector -->
  <div class="inspector" id="inspector">
    <div class="header">
      <div class="ico">
        <svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="14" rx="2"/><line x1="8" y1="22" x2="16" y2="22"/><line x1="12" y1="18" x2="12" y2="22"/></svg>
      </div>
      <div class="title">Browser Navigation Repl...</div>
      <div class="action-id">action-3</div>
      <div class="header-actions">
        <div class="icon-btn"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></div>
        <div class="icon-btn"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg></div>
        <div class="icon-btn"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="12" cy="19" r="1.6"/></svg></div>
        <div class="icon-btn" id="inspector-close"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></div>
      </div>
    </div>

    <div class="desc">Replay a saved browser navigation recording from the shared browser navigation sandbox</div>

    <div class="field">
      <label>Provider</label>
      <div class="select">
        <div class="ico"><svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="14" rx="2"/><line x1="8" y1="22" x2="16" y2="22"/><line x1="12" y1="18" x2="12" y2="22"/></svg></div>
        <div class="val">StackAI Computer</div>
        <div class="chev"><svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></div>
      </div>
    </div>

    <div class="field">
      <label>Action</label>
      <div class="select">
        <div class="ico" style="color:#ff6a3d;"><svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg></div>
        <div class="val">Browser Navigation Replay</div>
        <div class="chev"><svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></div>
      </div>
    </div>

    <div class="inputs-header">
      <span class="lead"><svg class="i" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span>
      General
      <span class="chev-up"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg></span>
    </div>

    <div class="general-body">
      <div class="seg-tabs">
        <div class="seg-group" role="tablist">
          <div class="seg-btn active" data-mode="ai">Browser Navigation AI</div>
          <div class="seg-btn" data-mode="manual">Browser Navigation Manual</div>
        </div>
      </div>
    </div>

    <div class="inputs-header">
      <span class="lead"><svg class="i" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12"/><polyline points="8 11 12 15 16 11"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg></span>
      Inputs
      <span class="required-pill">
        <svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        Has required fields
      </span>
      <span class="chev-up"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg></span>
    </div>

    <div class="inputs-body">
      <div class="view-toggle">
        <div class="vt-btn active" title="Tree view"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="9" y1="6" x2="21" y2="6"/><line x1="9" y1="12" x2="21" y2="12"/><line x1="9" y1="18" x2="21" y2="18"/><line x1="4" y1="6" x2="4.01" y2="6"/><line x1="4" y1="12" x2="4.01" y2="12"/><line x1="4" y1="18" x2="4.01" y2="18"/></svg></div>
        <div class="vt-btn" title="JSON view"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M8 4H6a2 2 0 0 0-2 2v4a2 2 0 0 1-2 2 2 2 0 0 1 2 2v4a2 2 0 0 0 2 2h2"/><path d="M16 4h2a2 2 0 0 1 2 2v4a2 2 0 0 0 2 2 2 2 0 0 0-2 2v4a2 2 0 0 1-2 2h-2"/></svg></div>
      </div>

      <div class="nested">
        <div class="nested-field-head">
          <span class="disc"><svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></span>
          <span class="fname">Saved Recording</span>
          <span class="req">*</span>
          <span class="type-label">string</span>
        </div>

        <div class="select-row">
          <div class="select">
            <div class="val placeholder">Select...</div>
            <div class="chev"><svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></div>
          </div>
          <div class="clear-btn" title="Clear"><svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></div>
        </div>

        <div class="info-callout">
          <span class="info-ico"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></span>
          <span>Record and replay browser workflows. Save a recording to make it appear in the dropdown. <a href="#">Watch demo</a></span>
        </div>

        <button id="new-recording-btn" class="new-recording-btn" style="width:auto;">
          <svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          New recording
        </button>

        <div class="helper-text">2 saved recordings available in the shared browser navigation sandbox.</div>
      </div>
    </div>

    <div class="section">
      <span class="lead"><svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></svg></span>
      Test Action
      <span class="chev-right"><svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></span>
    </div>

    <div class="section">
      <span class="lead"><svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2h-4"/><polyline points="12 2 12 15"/><polyline points="8 6 12 2 16 6"/></svg></span>
      Outputs
      <span class="chev-right"><svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></span>
    </div>

    <div class="section">
      <span class="lead"><svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4l6 6"/><circle cx="16" cy="16" r="4"/><path d="M20 20l-2-2"/></svg></span>
      Advanced Settings
      <span class="chev-right"><svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></span>
    </div>
  </div>
</div>

<!-- Browser Navigation Sandbox modal -->
<div class="modal-backdrop" id="sandbox-modal" hidden>
  <div class="sandbox-modal">
    <div class="sandbox-header">
      <div class="title">
        <span class="globe"><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"/></svg></span>
        Browser Navigation Sandbox
      </div>
      <div class="close">
        <svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </div>
    </div>

    <div class="browser">
      <div class="tabs">
        <div class="tab">
          <span class="fav"><svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"/></svg></span>
          <span class="tab-title">Stack AI — Sandbox</span>
          <span class="tab-close"><svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span>
        </div>
        <div class="tab-new">
          <svg class="i" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </div>
      </div>

      <div class="toolbar">
        <div class="nav-btn"><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg></div>
        <div class="nav-btn disabled"><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></div>
        <div class="nav-btn"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg></div>

        <div class="omnibox">
          <div class="site-lock">
            <svg class="i" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            https
          </div>
          <span class="url">stack-ai.com/sandbox/browser-navigation</span>
          <span class="omni-ico"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15 8.5 22 9.3 17 14.1 18.2 21 12 17.8 5.8 21 7 14.1 2 9.3 9 8.5 12 2"/></svg></span>
          <span class="omni-ico"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 12h8"/><path d="M12 8v8"/></svg></span>
        </div>

        <div class="ext-bar">
          <div class="ext-ico" title="Reading list"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg></div>
          <div class="ext-ico" title="Bookmark"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15 8.5 22 9.3 17 14.1 18.2 21 12 17.8 5.8 21 7 14.1 2 9.3 9 8.5 12 2"/></svg></div>
          <div class="ext-ico stackai" title="Stack AI Recorder"><span class="sa-logo"><svg viewBox="0 0 247 252" fill="#FF6B2C" xmlns="http://www.w3.org/2000/svg"><path d="M246.977 202.478v-56.281c0-5.389-2.84-10.383-7.471-13.171l-49.898-29.894a3.836 3.836 0 0 1-1.862-3.298v-58.21c0-4.041-2.118-7.804-5.609-9.871L133.938 2.88a20.387 20.387 0 0 0-20.899 0l-48.2 28.873c-3.467 2.09-5.608 5.83-5.608 9.871V99.88a3.839 3.839 0 0 1-1.862 3.299L7.47 133.003A15.354 15.354 0 0 0 0 146.173v56.282c0 7.735 3.863 14.889 10.1 18.652l46.175 28.013a15.404 15.404 0 0 0 15.965 0l49.503-29.778c1.21-.721 2.723-.697 3.933.023l51.062 30.963a11.578 11.578 0 0 0 11.986 0l48.175-29.221C243.137 217.321 247 210.19 247 202.455l-.023.023Zm-128.865 0c0 4.135-1.978 7.898-5.097 9.802l-38.843 23.553c-3.188 1.928-7.005-.766-7.005-4.947v-45.899c0-4.134 1.978-7.897 5.097-9.802l38.843-23.553c3.188-1.928 7.005.767 7.005 4.948v45.898Zm59.231-102.366c0 4.135-1.978 7.898-5.097 9.803l-38.843 23.553c-3.189 1.928-7.005-.767-7.005-4.948V82.622c0-4.135 1.978-7.898 5.096-9.802l38.844-23.553c3.188-1.928 7.005.766 7.005 4.947v45.898Zm59.231 102.366c0 4.135-1.979 7.898-5.097 9.802l-38.844 23.553c-3.188 1.928-7.005-.766-7.005-4.947v-45.899c0-4.134 1.978-7.897 5.097-9.802l38.843-23.553c3.189-1.928 7.006.767 7.006 4.948v45.898Z"/></svg></span></div>
          <div class="ext-ico" title="Extensions"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 4h4a2 2 0 0 1 2 2v4h-2a2 2 0 0 0 0 4h2v4a2 2 0 0 1-2 2h-4v-2a2 2 0 0 0-4 0v2H6a2 2 0 0 1-2-2v-4H2a2 2 0 0 0 0-4h2V6a2 2 0 0 1 2-2h4V2a2 2 0 0 1 4 0v2z"/></svg></div>
          <div class="ext-ico" title="Profile"><svg class="i" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
        </div>
        <div class="avatar">D</div>

        <!-- Blinking arrow pointing to the Stack AI extension icon -->
        <div class="ext-pointer">
          <svg class="arrow-up" width="22" height="24" viewBox="0 0 22 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="11" y1="22" x2="11" y2="4"/><polyline points="4 11 11 4 18 11"/></svg>
          <div class="tip"><span>Click</span> <span class="sa-logo"><svg viewBox="0 0 247 252" fill="#fff" xmlns="http://www.w3.org/2000/svg"><path d="M246.977 202.478v-56.281c0-5.389-2.84-10.383-7.471-13.171l-49.898-29.894a3.836 3.836 0 0 1-1.862-3.298v-58.21c0-4.041-2.118-7.804-5.609-9.871L133.938 2.88a20.387 20.387 0 0 0-20.899 0l-48.2 28.873c-3.467 2.09-5.608 5.83-5.608 9.871V99.88a3.839 3.839 0 0 1-1.862 3.299L7.47 133.003A15.354 15.354 0 0 0 0 146.173v56.282c0 7.735 3.863 14.889 10.1 18.652l46.175 28.013a15.404 15.404 0 0 0 15.965 0l49.503-29.778c1.21-.721 2.723-.697 3.933.023l51.062 30.963a11.578 11.578 0 0 0 11.986 0l48.175-29.221C243.137 217.321 247 210.19 247 202.455l-.023.023Zm-128.865 0c0 4.135-1.978 7.898-5.097 9.802l-38.843 23.553c-3.188 1.928-7.005-.766-7.005-4.947v-45.899c0-4.134 1.978-7.897 5.097-9.802l38.843-23.553c3.188-1.928 7.005.767 7.005 4.948v45.898Zm59.231-102.366c0 4.135-1.978 7.898-5.097 9.803l-38.843 23.553c-3.189 1.928-7.005-.767-7.005-4.948V82.622c0-4.135 1.978-7.898 5.096-9.802l38.844-23.553c3.188-1.928 7.005.766 7.005 4.947v45.898Zm59.231 102.366c0 4.135-1.979 7.898-5.097 9.802l-38.844 23.553c-3.188 1.928-7.005-.766-7.005-4.947v-45.899c0-4.134 1.978-7.897 5.097-9.802l38.843-23.553c3.189-1.928 7.006.767 7.006 4.948v45.898Z"/></svg></span> <span>to open the recorder</span></div>
        </div>
      </div>

      <div class="viewport">
        <div class="instructions">
          <h2>How to record the browser navigation?</h2>
          <div class="step"><span class="num">1</span>Open the extension in this sandbox browser</div>
          <div class="step"><span class="num">2</span>Click "Start Recording"</div>
          <div class="step"><span class="num">3</span>Navigate and interact with any site</div>
          <div class="step"><span class="num">4</span>Stop and save your workflow</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    const modal = document.getElementById('sandbox-modal');
    const openBtn = document.getElementById('new-recording-btn');
    const closeBtn = modal.querySelector('.close');

    const open = () => { modal.hidden = false; };
    const close = () => { modal.hidden = true; };

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });

    // Close the inspector (settings side panel) via the X button or by clicking outside it.
    const inspector = document.getElementById('inspector');
    const inspectorClose = document.getElementById('inspector-close');
    const hideInspector = () => { inspector.hidden = true; };

    if (inspectorClose) inspectorClose.addEventListener('click', hideInspector);

    document.addEventListener('click', (e) => {
      if (inspector.hidden) return;
      // Ignore clicks inside the inspector, on the modal, or on the node that opened it.
      if (inspector.contains(e.target)) return;
      if (e.target.closest && (e.target.closest('.modal-backdrop') || e.target.closest('.node'))) return;
      hideInspector();
    });

    document.querySelectorAll('.seg-tabs .seg-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        btn.parentElement.querySelectorAll('.seg-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
      });
    });
  })();
</script>

</body>
</html>
